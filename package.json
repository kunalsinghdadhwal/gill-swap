{
  "name": "gill-swap",
  "version": "0.1.0",
  "description": "Lightweight Solana swap automation backend scaffold using Gill SDK and Jupiter Aggregator architecture.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "config",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js --mode=server",
    "dev": "tsx watch src/index.ts --mode=server",
    "server": "tsx src/index.ts --mode=server",
    "swap": "tsx src/index.ts swap",
    "dca": "tsx src/index.ts dca",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --coverage",
    "lint": "eslint \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "solana",
    "backend",
    "gill",
    "jupiter",
    "automation",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@scalar/fastify-api-reference": "^1.52.3",
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "gill": "^0.14.0",
    "node-cron": "^4.2.1",
    "winston": "^3.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.7.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "ts-jest": "^29.2.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
