# Runtime environment
NODE_ENV=development

# Runtime mode selection in src/index.ts
# Allowed values: cli | server
APP_MODE=cli

# Solana / Jupiter integration inputs (placeholder values only)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HOT_WALLET_PATH=./secrets/hot-wallet.json
JUPITER_API_BASE_URL=https://quote-api.jup.ag/v6
JUPITER_API_KEY=

# Swap behavior defaults
DEFAULT_SLIPPAGE_BPS=50
PRIORITY_FEE_MICROLAMPORTS=0
ENABLE_POST_SWAP_MEMO=false

# Retry / timeout behavior
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=350
REQUEST_TIMEOUT_MS=10000

# Server settings
HOST=0.0.0.0
PORT=3000

# Logging
LOG_LEVEL=info

# Future monitor defaults
PRICE_MONITOR_CRON=*/30 * * * * *
